{
  "$schema": "../packages/schema/scene.schema.json",
  "schemaVersion": 1,
  "project": { "name": "Corner Shop", "repo": "github:acme/corner-shop" },
  "theme": "ecommerce-shop",
  "zones": [
    {
      "id": "auth",
      "label": "Authentication",
      "metaphor": "entrance",
      "parts": [
        { "id": "login", "label": "Login", "asset": "door", "issues": ["github:1", "github:2"] },
        { "id": "signup", "label": "Sign-up", "asset": "security-desk", "issues": ["github:3"] },
        { "id": "password-reset", "label": "Password reset", "issues": ["github:4"] }
      ]
    },
    {
      "id": "catalogue",
      "label": "Product catalogue",
      "metaphor": "shelves",
      "parts": [
        {
          "id": "product-list",
          "label": "Product list",
          "asset": "shelf",
          "issues": ["github:5", "github:6"]
        },
        { "id": "product-page", "label": "Product page", "asset": "shelf", "issues": ["github:7"] },
        { "id": "categories", "label": "Categories", "asset": "aisle-sign", "issues": ["github:8"] }
      ]
    },
    {
      "id": "cart",
      "label": "Cart",
      "metaphor": "trolley",
      "parts": [
        { "id": "add-to-cart", "label": "Add to cart", "issues": ["github:9"] },
        { "id": "cart-page", "label": "Cart page", "issues": ["github:10"] }
      ]
    },
    {
      "id": "checkout",
      "label": "Checkout & payments",
      "metaphor": "counter",
      "parts": [
        {
          "id": "payment-form",
          "label": "Payment form",
          "asset": "card-reader",
          "issues": ["github:11"]
        },
        {
          "id": "order-summary",
          "label": "Order summary",
          "asset": "till",
          "issues": ["github:12"]
        },
        { "id": "receipts", "label": "Receipts", "issues": ["github:13"] }
      ]
    },
    {
      "id": "inventory",
      "label": "Inventory",
      "metaphor": "warehouse",
      "parts": [
        {
          "id": "stock-levels",
          "label": "Stock levels",
          "asset": "pallet",
          "issues": ["github:14"]
        },
        { "id": "restock-alerts", "label": "Restock alerts", "issues": ["github:15"] }
      ]
    },
    {
      "id": "notifications",
      "label": "Notifications",
      "description": "Common-kit metaphor: letters travel mailbox → sorting station → letterbox",
      "metaphor": "postal-route",
      "parts": [
        {
          "id": "order-emails",
          "label": "Order emails",
          "asset": "mailbox",
          "issues": ["github:16"]
        },
        {
          "id": "shipping-updates",
          "label": "Shipping updates",
          "asset": "sorting-station",
          "issues": ["github:17"]
        }
      ]
    }
  ],
  "flows": [
    { "from": "auth", "to": "cart", "label": "identify shopper" },
    { "from": "catalogue", "to": "cart", "label": "add item" },
    { "from": "cart", "to": "checkout", "label": "place order" },
    { "from": "checkout", "to": "inventory", "label": "reserve stock" },
    { "from": "checkout", "to": "notifications", "label": "order confirmation" }
  ]
}
